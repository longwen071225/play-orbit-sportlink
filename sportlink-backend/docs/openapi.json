        "summary": "健康检查：运行模式、模型与当前价目表",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "true on success, false on error"
                    },
                    "data": {
                      "nullable": true,
                      "description": "Payload on success; null on error"
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Machine readable error code"
                        },
                        "message": {
                          "type": "string",
                          "description": "Human readable message"
                        },
                        "details": {
                          "description": "Optional structured details"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false,
                      "nullable": true,
                      "description": "Error body on failure; null on success"
                    },
                    "requestId": {
                      "type": "string",
                      "description": "Unique id for this request (also x-request-id header)"
                    }
                  },
                  "required": [
                    "success",
                    "error",
                    "requestId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
