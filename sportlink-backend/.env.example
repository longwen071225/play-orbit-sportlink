# ---------- Server ----------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Dev CORS: "*" allows everything; set a comma separated list of origins to restrict.
CORS_ORIGIN=*

# ---------- Database (SQLite) ----------
DATABASE_URL="file:./dev.db"

# ---------- Alibaba Bailian / DashScope (OpenAI-compatible) ----------
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# ---------- AI mode ----------
# auto  = use mock AI when DASHSCOPE_API_KEY is empty
# true  = always use mock AI (no network calls)
# false = force real LLM (requires a valid DASHSCOPE_API_KEY)
MOCK_AI=auto

# ---------- Pricing (amounts are in CNY cents, configurable) ----------
PRICE_SINGLE_CENTS=12900
PRICE_PACKAGE_4_CENTS=49900
PACKAGE_SESSIONS=4
