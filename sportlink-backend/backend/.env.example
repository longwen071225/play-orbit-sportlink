# SoloPilot / Alibaba Bailian (OpenAI-compatible)
# Copy to backend/.env. Real OS environment variables override this file.
# The SOLOPILOT_ prefix keeps these separate from the legacy Node service's
# root .env (which defines its own DASHSCOPE_MODEL=qwen-plus).
# NOTE: region-specific. Beijing / Singapore / Hong Kong keys and base URLs are
# NOT interchangeable. See README_SoloPilot.md for the URL table.

# ---- Credentials (NEVER commit the real key) ----
SOLOPILOT_DASHSCOPE_API_KEY=
SOLOPILOT_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOLOPILOT_DASHSCOPE_REGION=beijing

# ---- Models ----
SOLOPILOT_DASHSCOPE_MODEL=qwen3.7-plus
SOLOPILOT_DASHSCOPE_FALLBACK_MODEL=qwen3.8-max

# ---- LLM mode: auto | mock | real ----
# auto  = real when a key is present, otherwise offline mock
# mock  = never call the network (full tool loop still runs)
# real  = force real Bailian calls (fails clearly if no key)
SOLOPILOT_LLM_MODE=auto
SOLOPILOT_LLM_TIMEOUT_SECONDS=30
SOLOPILOT_LLM_MAX_RETRIES=2
SOLOPILOT_LLM_RETRY_BASE_DELAY=0.5

# ---- Tool loop ----
SOLOPILOT_MAX_TOOL_ROUNDS=6
# Set true to simulate a region/model without Function Calling (forces the
# state-machine fallback and reports it explicitly).
SOLOPILOT_FORCE_STATE_MACHINE=false

# ---- Database: reuses the existing Prisma SQLite file ----
SOLOPILOT_DATABASE_PATH=prisma/dev.db

# ---- Seed values for the DB-backed price_item table ----
SOLOPILOT_PRICE_SINGLE_CENTS=12900
SOLOPILOT_PRICE_PACKAGE4_CENTS=49900
SOLOPILOT_PACKAGE_SESSIONS=4

# ---- Local server ----
SOLOPILOT_HOST=127.0.0.1
SOLOPILOT_PORT=8100

# ---- StarFit (星动到家) platform ----
# Server-side HMAC secret for auth tokens. Set a long random value in production.
SOLOPILOT_STARFIT_SECRET=
# Seed demo users/coaches/exercises on startup when sf_user is empty (idempotent).
SOLOPILOT_STARFIT_SEED_DEMO=true
